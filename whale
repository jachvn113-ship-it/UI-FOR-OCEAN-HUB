local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LP   = Players.LocalPlayer
local char, hrp, hum

local Remote      = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Input")
local WhaleFolder = workspace:WaitForChild("Whale")

-- ============ CONFIG ============
local SPEED            = 250     -- ⭐ an toàn, không bị shadow ban
local SCAN_INTERVAL    = 0.5

local STAND_DISTANCE   = 60
local EDGE_PADDING     = 10
local HOVER_Y_OFFSET   = 5

local SAFE_HEIGHT      = 60
local HIGH_Y_MIN       = 120
local H_ARRIVE_XZ      = 120
local DESCEND_SPEED    = 200     -- ⭐ hạ cánh chậm, mượt
local SEND_INTERVAL    = 0.08    -- ⭐ 12.5 dash/giây, không rate-limit

local MIN_FLIGHT_TIME  = 1.5
local MIN_FLIGHT_DIST  = 30
local MAX_WHALE_RADIUS = 300

local ARRIVE_TOLERANCE = 5
local ARRIVE_Y_TOL     = 8

local REARM_COOLDOWN   = 5
local AUTO_RETRY_DELAY = 2

-- ⭐ Watchdog
local STUCK_TIME_LIMIT = 3.0

-- ============ STATE ============
local ENABLED      = false
local AUTO_MODE    = true
local currentTarget = nil
local lastScan     = 0
local lastSend     = 0
local toggleBtn    = nil
local autoBtn      = nil
local forceBtn     = nil
local statusLabel  = nil

local flightStartTime = 0
local flightStartPos  = nil

local lastReleasedWhale = nil
local lastReleaseTime   = 0
local lastAutoRetry     = 0
local processedWhales   = {}

local lastPos = Vector3.zero
local stuckTimer = 0

-- ============ XOÁ UI CŨ ============
for _, g in ipairs(LP:WaitForChild("PlayerGui"):GetChildren()) do
    if g.Name == "AutoWhaleUI" or g.Name:match("^AutoWhaleUI") then
        g:Destroy()
    end
end

-- ============ HELPER (khai báo trước) ============
local function getWhaleInfo(model)
    if not model or not model.Parent then return nil, 0 end

    local center
    local ok, cf = pcall(function() return model:GetBoundingBox() end)
    if ok and cf then
        center = cf.Position
    else
        local part = model:FindFirstChildWhichIsA("BasePart", true)
        if part then center = part.Position end
    end
    if not center then return nil, 0 end

    local maxR = 0
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency < 0.9 then
            local r = math.max(d.Size.X, d.Size.Z) * 0.5
            if r > maxR then maxR = r end
        end
    end
    if maxR > MAX_WHALE_RADIUS then maxR = MAX_WHALE_RADIUS end

    return center, maxR
end

local function sendDash(cf)
    local now = tick()
    if now - lastSend >= SEND_INTERVAL then
        Remote:FireServer("Dash", cf)
        lastSend = now
    end
end

local function isProcessed(whale)
    return processedWhales[whale] == true
end

local function findNearestWhale()
    if not hrp then return nil end
    local myPos = hrp.Position
    local best, bestDist = nil, math.huge
    for _, model in ipairs(WhaleFolder:GetChildren()) do
        if model:IsA("Model") and not isProcessed(model) then
            local center = getWhaleInfo(model)
            if center then
                local d = (center - myPos).Magnitude
                if d < bestDist then best, bestDist = model, d end
            end
        end
    end
    return best
end

local function scanFolder(force)
    local now = tick()
    if not force and now - lastScan < SCAN_INTERVAL then return end
    lastScan = now

    if currentTarget and currentTarget.Parent and not isProcessed(currentTarget) then
        return
    end

    currentTarget = nil
    currentTarget = findNearestWhale()
end

-- ============ SET ENABLED ============
function setEnabled(state)
    ENABLED = state
    if char then
        local h = char:FindFirstChildOfClass("Humanoid")
        local r = char:FindFirstChild("HumanoidRootPart")
        if h then
            h.PlatformStand = state
            h.WalkSpeed     = state and 0 or 16
            h.JumpPower     = state and 0 or 50
            h.UseJumpPower  = true
        end
        if r then
            r.AssemblyLinearVelocity  = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end
    end

    if state and hrp then
        flightStartTime = tick()
        flightStartPos  = hrp.Position
        lastPos = hrp.Position
        stuckTimer = 0
    end
end

local function syncUI()
    if toggleBtn then
        if ENABLED then
            toggleBtn.Text = "ON"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
        else
            toggleBtn.Text = "OFF"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        end
    end
    if autoBtn then
        if AUTO_MODE then
            autoBtn.Text = "AUTO ✓"
            autoBtn.BackgroundColor3 = Color3.fromRGB(50, 130, 200)
        else
            autoBtn.Text = "AUTO ✗"
            autoBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
        end
    end
end

-- ============ CHARACTER HANDLER ============
local function onCharacterAdded(newChar)
    char = newChar
    hrp  = char:WaitForChild("HumanoidRootPart")
    hum  = char:WaitForChild("Humanoid")

    -- ⭐ Reset state khi respawn
    currentTarget = nil
    flightStartTime = tick()
    flightStartPos = hrp.Position
    lastPos = hrp.Position
    stuckTimer = 0

    if ENABLED then
        hum.PlatformStand = true
        hum.WalkSpeed     = 0
        hum.JumpPower     = 0
        hum.UseJumpPower  = true
    end

    task.wait(0.5)
    scanFolder(true)
end

if LP.Character then
    task.spawn(onCharacterAdded, LP.Character)
end
LP.CharacterAdded:Connect(onCharacterAdded)

-- ============ WHALE FOLDER EVENT ============
WhaleFolder.ChildAdded:Connect(function(child)
    if not child:IsA("Model") then return end

    if AUTO_MODE and not ENABLED then
        local now = tick()
        if now - lastReleaseTime < REARM_COOLDOWN then return end
        if isProcessed(child) then return end

        task.wait(0.3)
        if child.Parent then
            currentTarget = child
            setEnabled(true)
            syncUI()
        end
    else
        if ENABLED and (not currentTarget or not currentTarget.Parent) then
            currentTarget = child
        end
    end
end)

-- ============ RELEASE ============
local function releaseCharacter()
    if not char then return end
    local h = char:FindFirstChildOfClass("Humanoid")
    local r = char:FindFirstChild("HumanoidRootPart")
    if h then
        h.PlatformStand = false
        h.WalkSpeed     = 16
        h.JumpPower     = 50
        h.UseJumpPower  = true
    end
    if r then
        r.AssemblyLinearVelocity  = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
end

local function markReleased(whale)
    if whale then
        processedWhales[whale] = true
        lastReleasedWhale = whale
    end
    lastReleaseTime = tick()
end

task.spawn(function()
    while true do
        task.wait(10)
        for w in pairs(processedWhales) do
            if typeof(w) ~= "Instance" or not w.Parent then
                processedWhales[w] = nil
            end
        end
    end
end)

