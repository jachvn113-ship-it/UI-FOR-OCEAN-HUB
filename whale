-- ============================================
-- AUTO WHALE v4 — FIX HẠ XUỐNG
-- ============================================

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LP   = Players.LocalPlayer
local char = LP.Character or LP.CharacterAdded:Wait()
local hrp  = char:WaitForChild("HumanoidRootPart")
local hum  = char:WaitForChild("Humanoid")

local Remote      = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Input")
local WhaleFolder = workspace:WaitForChild("Whale")

-- ============ CONFIG ============
local SPEED          = 200
local STOP_DISTANCE  = 50
local SCAN_INTERVAL  = 0.5

local SAFE_HEIGHT    = 60     -- giảm từ 80
local HIGH_Y_MIN     = 120    -- giảm từ 150
local H_ARRIVE_XZ    = 60     -- bắt đầu hạ sớm hơn (từ 40 -> 60)
local DESCEND_SPEED  = 300    -- tốc độ hạ nhanh hơn bay ngang

-- ============ STATE ============
local ENABLED = false
local currentTarget = nil
local lastScan      = 0
local phase         = "idle"  -- "rise" | "fly" | "descend" | "idle"

-- ============ HELPER ============
local function getModelPosition(model)
    if not model or not model.Parent then return nil end
    if model.PrimaryPart then return model.PrimaryPart.Position end
    local part = model:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function sendDash(cf) Remote:FireServer("Dash", cf) end

local function findNearestWhale()
    local myPos = hrp.Position
    local best, bestDist = nil, math.huge
    for _, model in ipairs(WhaleFolder:GetChildren()) do
        if model:IsA("Model") then
            local pos = getModelPosition(model)
            if pos then
                local d = (pos - myPos).Magnitude
                if d < bestDist then best, bestDist = model, d end
            end
        end
    end
    return best
end

local function scanFolder(force)
    local now = tick()
    if not force and now - lastScan < SCAN_INTERVAL then return end
    lastScan = now
    local newTarget = findNearestWhale()
    if newTarget and newTarget ~= currentTarget then
        currentTarget = newTarget
    elseif not newTarget then
        currentTarget = nil
    end
end

WhaleFolder.ChildAdded:Connect(function(child)
    if child:IsA("Model") and ENABLED then
        currentTarget = child
    end
end)

-- ============ ON/OFF ============
local function setEnabled(state)
    ENABLED = state
    phase = "idle"
    local c = LP.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        local r = c:FindFirstChild("HumanoidRootPart")
        if h then
            h.PlatformStand = state
            h.WalkSpeed     = state and 0 or 16
            h.JumpPower     = state and 0 or 50
            h.UseJumpPower  = true
        end
        if r then
            r.AssemblyLinearVelocity  = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

-- ============ UI ============
local function createUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "AutoWhaleUI"
    gui.ResetOnSpawn = false
    gui.Parent = LP:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 85)
    frame.Position = UDim2.new(0, 20, 0, 100)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(60, 60, 70)
    stroke.Thickness = 1.5

    local title = Instance.new("TextLabel", frame)
    title.Size = UDim2.new(1, 0, 0, 25)
    title.Position = UDim2.new(0, 0, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = "🐋 AUTO WHALE v4"
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.TextColor3 = Color3.fromRGB(240, 240, 240)

    local status = Instance.new("TextLabel", frame)
    status.Name = "Status"
    status.Size = UDim2.new(1, -20, 0, 14)
    status.Position = UDim2.new(0, 10, 0, 28)
    status.BackgroundTransparency = 1
    status.Text = "Trạng thái: idle"
    status.Font = Enum.Font.Gotham
    status.TextSize = 11
    status.TextColor3 = Color3.fromRGB(160, 160, 170)
    status.TextXAlignment = Enum.TextXAlignment.Left

    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(1, -20, 0, 26)
    btn.Position = UDim2.new(0, 10, 0, 48)
    btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    btn.BorderSizePixel = 0
    btn.Text = "OFF"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        setEnabled(not ENABLED)
        if ENABLED then
            btn.Text = "ON"
            btn.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
            scanFolder(true)
        else
            btn.Text = "OFF"
            btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        end
    end)

    return gui, status
end

local ui, statusLabel = createUI()

-- ============ MAIN LOOP ============
RunService.Heartbeat:Connect(function(dt)
    if not char.Parent or not hrp.Parent then
        char = LP.Character or LP.CharacterAdded:Wait()
        hrp  = char:WaitForChild("HumanoidRootPart")
        hum  = char:WaitForChild("Humanoid")
        if ENABLED then hum.PlatformStand = true; hum.WalkSpeed = 0 end
        return
    end

    if not ENABLED then
        statusLabel.Text = "Trạng thái: OFF"
        return
    end

    scanFolder(false)
    if not currentTarget or not currentTarget.Parent then
        currentTarget = nil
        statusLabel.Text = "Trạng thái: chờ whale..."
        phase = "idle"
        return
    end

    local targetPos = getModelPosition(currentTarget)
    if not targetPos then return end

    local myPos = hrp.CFrame.Position

    -- Vector & khoảng cách
    local dY      = targetPos.Y - myPos.Y
    local flatVec = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)
    local flatDist = flatVec.Magnitude
    local trueDist = (targetPos - myPos).Magnitude

    -- Đã tới nơi
    if trueDist <= STOP_DISTANCE then
        statusLabel.Text = string.format("Trạng thái: ĐÃ TỚI (%.0f studs)", trueDist)
        phase = "idle"
        return
    end

    -- ============ QUYẾT ĐỊNH GIAI ĐOẠN ============
    local moveTarget
    local speed = SPEED

    -- Ưu tiên 1: XZ đã gần whale -> HẠ XUỐNG (hoặc bay lên nếu whale cao hơn)
    if flatDist <= H_ARRIVE_XZ then
        phase = "descend"
        speed = DESCEND_SPEED
        moveTarget = targetPos  -- bay thẳng tới whale
    -- Ưu tiên 2: Còn xa XZ -> cần vượt tường, bay lên cao trước
    else
        local safeY = math.max(targetPos.Y + SAFE_HEIGHT, HIGH_Y_MIN)
        if myPos.Y < safeY - 10 then
            -- BAY LÊN
            phase = "rise"
            moveTarget = Vector3.new(myPos.X, safeY, myPos.Z)
        else
            -- BAY NGANG TRÊN CAO
            phase = "fly"
            moveTarget = Vector3.new(targetPos.X, safeY, targetPos.Z)
        end
    end

    -- ============ DI CHUYỂN ============
    local diff     = moveTarget - myPos
    local distance = diff.Magnitude

    statusLabel.Text = string.format("Trạng thái: %s | XZ:%.0f | Y:%.0f", phase, flatDist, dY)

    if distance < 0.5 then return end

    local dir  = diff.Unit
    local step = math.min(speed * dt, distance)
    local newPos = myPos + dir * step
    local newCF  = CFrame.new(newPos) * (hrp.CFrame - hrp.CFrame.Position)

    hrp.CFrame = newCF
    hrp.AssemblyLinearVelocity  = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    sendDash(newCF)
end)

print("[AutoWhale v4] Loaded — click ON để bật")
