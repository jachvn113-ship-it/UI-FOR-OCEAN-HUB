-- ============================================
-- AUTO WHALE v8 — NÉ TƯỜNG NHƯNG KHÔNG LÊN TRỜI GẦN WHALE
-- ============================================

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LP   = Players.LocalPlayer
local char = LP.Character or LP.CharacterAdded:Wait()
local hrp  = char:WaitForChild("HumanoidRootPart")
local hum  = char:WaitForChild("Humanoid")

local Remote      = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Input")
local WhaleFolder = workspace:WaitForChild("Whale")

-- ============ CONFIG ============
local SPEED           = 200
local SCAN_INTERVAL   = 0.5
local SEND_INTERVAL   = 0.05

-- Điểm đứng
local STAND_DISTANCE  = 60    -- cách mép whale
local HOVER_Y         = 5
local STOP_XZ_TOL     = 5

-- Né tường
local RAY_LENGTH      = 40    -- tầm nhìn tia laser
local RAY_SIDE_LENGTH = 25
local SAFE_HEIGHT     = 60    -- bay cao hơn tường bao nhiêu
local HIGH_Y_MIN      = 120   -- độ cao Y tối thiểu khi bay lên
local NO_RISE_DIST    = 200   -- trong khoảng này tới whale thì KHÔNG bay lên nữa
local IGNORE_TAGS     = { "Whale" }

-- ============ STATE ============
local ENABLED = false
local currentTarget = nil
local lastScan = 0
local lastSend = 0

-- ============ XOÁ UI CŨ ============
for _, g in ipairs(LP:WaitForChild("PlayerGui"):GetChildren()) do
    if g.Name == "AutoWhaleUI" or g.Name:match("^AutoWhaleUI") then
        g:Destroy()
    end
end

-- ============ RAYCAST ============
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function refreshRayFilter()
    local ignore = { char }
    if currentTarget then table.insert(ignore, currentTarget) end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            for _, tag in ipairs(IGNORE_TAGS) do
                if obj:HasTag(tag) then table.insert(ignore, obj); break end
            end
            if not obj.CanCollide and not obj.CanTouch then
                table.insert(ignore, obj)
            end
        end
    end
    rayParams.FilterDescendantsInstances = ignore
end

local function rayBlocked(origin, dir, length)
    return workspace:Raycast(origin, dir * length, rayParams) ~= nil
end

-- Kiểm tra đường thẳng có thông không (3 tia song song)
local function pathClear(origin, dir, length)
    if rayBlocked(origin, dir, length) then return false end
    local right = dir:Cross(Vector3.new(0,1,0))
    if right.Magnitude < 0.01 then right = Vector3.new(1,0,0) else right = right.Unit end
    if rayBlocked(origin + right * 3, dir, length) then return false end
    if rayBlocked(origin - right * 3, dir, length) then return false end
    return true
end

-- ============ HELPER ============
local function getWhaleInfo(model)
    if not model or not model.Parent then return nil end
    local ok, cf, size = pcall(function()
        local c, s = model:GetBoundingBox()
        return c, s
    end)
    if ok and cf and size then
        return { center = cf.Position, radius = math.max(size.X, size.Z) * 0.5, size = size }
    end
    local part = model:FindFirstChildWhichIsA("BasePart", true)
    if part then
        return { center = part.Position, radius = math.max(part.Size.X, part.Size.Z) * 0.5, size = part.Size }
    end
    return nil
end

local function sendDash(cf)
    local now = tick()
    if now - lastSend >= SEND_INTERVAL then
        Remote:FireServer("Dash", cf)
        lastSend = now
    end
end

local function findNearestWhale()
    local myPos = hrp.Position
    local best, bestDist = nil, math.huge
    for _, model in ipairs(WhaleFolder:GetChildren()) do
        if model:IsA("Model") then
            local info = getWhaleInfo(model)
            if info then
                local d = (info.center - myPos).Magnitude
                if d < bestDist then best, bestDist = model, d end
            end
        end
    end
    return best
end

local function scanFolder(force)
    local now = tick()
    if not force and now - lastScan < SCAN_INTERVAL then return end
    lastScan = now
    local newTarget = findNearestWhale()
    if newTarget and newTarget ~= currentTarget then
        currentTarget = newTarget
        refreshRayFilter()
    elseif not newTarget then
        currentTarget = nil
    end
end

WhaleFolder.ChildAdded:Connect(function(child)
    if child:IsA("Model") and ENABLED then
        currentTarget = child
        refreshRayFilter()
    end
end)

-- ============ ON/OFF ============
local function setEnabled(state)
    ENABLED = state
    local c = LP.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        local r = c:FindFirstChild("HumanoidRootPart")
        if h then
            h.PlatformStand = state
            h.WalkSpeed     = state and 0 or 16
            h.JumpPower     = state and 0 or 50
            h.UseJumpPower  = true
        end
        if r then
            r.AssemblyLinearVelocity  = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

-- ============ UI ============
local function createUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "AutoWhaleUI"
    gui.ResetOnSpawn = false
    gui.Parent = LP:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 220, 0, 85)
    frame.Position = UDim2.new(0, 20, 0, 100)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(60, 60, 70)
    stroke.Thickness = 1.5

    local title = Instance.new("TextLabel", frame)
    title.Size = UDim2.new(1, 0, 0, 25)
    title.Position = UDim2.new(0, 0, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = "🐋 AUTO WHALE v8"
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.TextColor3 = Color3.fromRGB(240, 240, 240)

    local status = Instance.new("TextLabel", frame)
    status.Size = UDim2.new(1, -20, 0, 14)
    status.Position = UDim2.new(0, 10, 0, 28)
    status.BackgroundTransparency = 1
    status.Text = "Trạng thái: idle"
    status.Font = Enum.Font.Gotham
    status.TextSize = 11
    status.TextColor3 = Color3.fromRGB(160, 160, 170)
    status.TextXAlignment = Enum.TextXAlignment.Left

    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(1, -20, 0, 26)
    btn.Position = UDim2.new(0, 10, 0, 48)
    btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    btn.BorderSizePixel = 0
    btn.Text = "OFF"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        setEnabled(not ENABLED)
        if ENABLED then
            btn.Text = "ON"
            btn.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
            scanFolder(true)
        else
            btn.Text = "OFF"
            btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        end
    end)

    return gui, status
end

local ui, statusLabel = createUI()

-- ============ MAIN LOOP ============
RunService.Heartbeat:Connect(function(dt)
    if not char.Parent or not hrp.Parent then
        char = LP.Character or LP.CharacterAdded:Wait()
        hrp  = char:WaitForChild("HumanoidRootPart")
        hum  = char:WaitForChild("Humanoid")
        if ENABLED then hum.PlatformStand = true; hum.WalkSpeed = 0 end
        return
    end

    if not ENABLED then
        statusLabel.Text = "Trạng thái: OFF"
        return
    end

    scanFolder(false)
    if not currentTarget or not currentTarget.Parent then
        currentTarget = nil
        statusLabel.Text = "Trạng thái: chờ whale..."
        return
    end

    local info = getWhaleInfo(currentTarget)
    if not info then return end

    local myPos  = hrp.Position
    local center = info.center

    -- Vector ngang từ tâm whale tới player
    local horiz = Vector3.new(myPos.X - center.X, 0, myPos.Z - center.Z)
    if horiz.Magnitude < 0.1 then horiz = Vector3.new(1, 0, 0) end
    local horizUnit = horiz.Unit

    -- Điểm đứng (cách mép whale STAND_DISTANCE)
    local standRadius = info.radius + STAND_DISTANCE
    local standXZ     = Vector3.new(center.X, 0, center.Z) + horizUnit * standRadius
    local standY      = center.Y + HOVER_Y
    local standPos    = Vector3.new(standXZ.X, standY, standZ or standXZ.Z)

    local distToCenter = horiz.Magnitude
    local distToStand  = (standPos - myPos).Magnitude

    -- ============ STOP ============
    if math.abs(distToCenter - standRadius) <= STOP_XZ_TOL
       and math.abs(myPos.Y - standY) <= 6 then
        statusLabel.Text = string.format("✅ ĐÃ ĐỨNG (cách mép:%.0f)", distToCenter - info.radius)
        return
    end

    -- ============ XÁC ĐỊNH CÓ ĐƯỢC PHÉP BAY LÊN KHÔNG ============
    -- Khoảng cách XZ tới mép whale
    local edgeDist = distToCenter - info.radius
    -- Chỉ được bay lên khi: CÒN XA whale (ngoài NO_RISE_DIST) VÀ đường bị chặn
    local allowRise = edgeDist > NO_RISE_DIST

    local moveTarget = standPos
    local speed      = SPEED
    local phaseText  = "fly"

    if allowRise then
        -- Kiểm tra đường thẳng tới điểm đứng có thông không
        local dirToStand = (standPos - myPos)
        local flatDir    = Vector3.new(dirToStand.X, 0, dirToStand.Z)
        local len        = math.min(flatDir.Magnitude, RAY_LENGTH)
        if len > 0.1 then
            local checkDir = flatDir.Unit
            if not pathClear(myPos, checkDir, len) then
                -- CÓ VẬT CẢN → BAY LÊN
                local safeY = math.max(center.Y + SAFE_HEIGHT, HIGH_Y_MIN)
                if myPos.Y < safeY - 10 then
                    phaseText = "rise"
                    moveTarget = Vector3.new(myPos.X, safeY, myPos.Z)
                else
                    phaseText = "fly-high"
                    moveTarget = Vector3.new(standXZ.X, safeY, standXZ.Z)
                end
            end
        end
    else
        -- GẦN WHALE → KHÔNG bay lên, đi thẳng tới điểm đứng
        phaseText = "final"
        speed = SPEED
    end

    if distToStand < 0.5 then return end

    local diff     = moveTarget - myPos
    local distance = diff.Magnitude
    local dir      = diff.Unit
    local step     = math.min(speed * dt, distance)
    local newPos   = myPos + dir * step
    local newCF    = CFrame.new(newPos) * (hrp.CFrame - hrp.CFrame.Position)

    hrp.CFrame = newCF
    hrp.AssemblyLinearVelocity  = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    sendDash(newCF)

    statusLabel.Text = string.format("%s | cách mép:%.0f | Y:%.0f", phaseText, edgeDist, myPos.Y - standY)
end)

print("[AutoWhale v8] Loaded — né tường khi xa, đi thẳng khi gần whale")
