-- ============ MAIN LOOP ============
RunService.Heartbeat:Connect(function(dt)
    if not char or not char.Parent or not hrp or not hrp.Parent then
        return
    end

    -- AUTO: nếu chưa bật + AUTO_MODE + chưa cooldown → thử bật
    if not ENABLED then
        if AUTO_MODE then
            local now = tick()
            if now - lastReleaseTime >= REARM_COOLDOWN
               and now - lastAutoRetry >= AUTO_RETRY_DELAY then
                lastAutoRetry = now
                local w = findNearestWhale()
                if w then
                    currentTarget = w
                    setEnabled(true)
                    syncUI()
                else
                    statusLabel.Text = "AUTO: chờ whale..."
                end
            else
                statusLabel.Text = string.format("AUTO: cooldown %.1fs", REARM_COOLDOWN - (now - lastReleaseTime))
            end
        else
            statusLabel.Text = "Trạng thái: OFF"
        end
        return
    end

    scanFolder(false)
    if not currentTarget or not currentTarget.Parent then
        currentTarget = nil
        statusLabel.Text = "chờ whale..."
        return
    end

    local center, whaleRadius = getWhaleInfo(currentTarget)
    if not center then return end

    local myPos = hrp.Position
    local standDist = math.max(STAND_DISTANCE, whaleRadius + EDGE_PADDING)

    local horiz = Vector3.new(myPos.X - center.X, 0, myPos.Z - center.Z)
    if horiz.Magnitude < 0.1 then horiz = Vector3.new(1, 0, 0) end
    local horizUnit = horiz.Unit

    local standXZ  = Vector3.new(center.X, 0, center.Z) + horizUnit * standDist
    local standY   = center.Y + HOVER_Y_OFFSET
    local standPos = Vector3.new(standXZ.X, standY, standXZ.Z)

    local flatDist = horiz.Magnitude
    local dy       = myPos.Y - standY

    local flightTime = tick() - flightStartTime
    local flightDist = flightStartPos and (myPos - flightStartPos).Magnitude or 0
    local canRelease = flightTime >= MIN_FLIGHT_TIME and flightDist >= MIN_FLIGHT_DIST

    -- ============ ĐÃ TỚI → THẢ ============
    if canRelease
       and flatDist <= standDist + ARRIVE_TOLERANCE
       and math.abs(dy) <= ARRIVE_Y_TOL then
        statusLabel.Text = string.format("✅ TỚI (%.0f/%.0f) — thả", flatDist, standDist)
        markReleased(currentTarget)
        setEnabled(false)
        releaseCharacter()
        syncUI()
        return
    end

    -- ============ QUYẾT ĐỊNH ============
    local arriveXZ = math.max(H_ARRIVE_XZ, standDist + 40)
    local moveTarget, speed, phase

    if flatDist > arriveXZ then
        local safeY = math.max(center.Y + SAFE_HEIGHT, HIGH_Y_MIN)
        if myPos.Y < safeY - 10 then
            phase = "rise"
            speed = SPEED
            moveTarget = Vector3.new(myPos.X, safeY, myPos.Z)
        else
            phase = "fly"
            speed = SPEED
            moveTarget = Vector3.new(standXZ.X, safeY, standXZ.Z)
        end
    else
        phase = "desc"
        speed = DESCEND_SPEED
        moveTarget = standPos
    end

    -- ⭐ Giảm tốc khi gần whale (tránh flag anti-cheat)
    if flatDist < 300 then
        speed = math.min(speed, 150)
    end
    if flatDist < 150 then
        speed = math.min(speed, 100)
    end
    if flatDist < standDist + 50 then
        speed = math.min(speed, 80)
    end

    -- ⭐ Watchdog: 3s không di chuyển → re-fire dash
    local moved = (myPos - lastPos).Magnitude
    if moved < 1 then
        stuckTimer = stuckTimer + dt
        if stuckTimer >= STUCK_TIME_LIMIT then
            stuckTimer = 0
            Remote:FireServer("Dash", hrp.CFrame)
        end
    else
        stuckTimer = 0
    end
    lastPos = myPos

    statusLabel.Text = string.format(
        "%s d=%.0f r=%.0f dy=%.0f %s",
        phase, flatDist, standDist, dy,
        canRelease and "" or "(lock)"
    )

    -- ============ DI CHUYỂN ============
    local diff     = moveTarget - myPos
    local distance = diff.Magnitude
    if distance < 0.5 then return end

    local dir  = diff.Unit
    local step = math.min(speed * dt, distance)
    local newPos = myPos + dir * step
    local newCF  = CFrame.new(newPos) * (hrp.CFrame - hrp.CFrame.Position)

    hrp.CFrame = newCF
    hrp.AssemblyLinearVelocity  = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    sendDash(newCF)
end)

