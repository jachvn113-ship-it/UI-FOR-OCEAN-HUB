-- ============================================
-- AUTO WHALE v10 — STAND POS CỐ ĐỊNH
-- ============================================

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LP   = Players.LocalPlayer
local char = LP.Character or LP.CharacterAdded:Wait()
local hrp  = char:WaitForChild("HumanoidRootPart")
local hum  = char:WaitForChild("Humanoid")

local Remote      = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Input")
local WhaleFolder = workspace:WaitForChild("Whale")

-- ============ CONFIG ============
local SPEED           = 200
local SCAN_INTERVAL   = 0.5
local SEND_INTERVAL   = 0.08

local STAND_DISTANCE  = 60
local HOVER_Y         = 5
local STOP_TOL        = 10    -- dung sai dừng (studs, 3D)
local MAX_RADIUS      = 300

local RAY_LENGTH      = 40
local SAFE_HEIGHT     = 60
local HIGH_Y_MIN      = 120
local NO_RISE_DIST    = 250
local IGNORE_TAGS     = { "Whale", "Effect", "VFX", "Beam" }
local STUCK_TIME      = 1.0

-- ============ STATE ============
local ENABLED = false
local currentTarget = nil
local frozenStandPos = nil    -- ⭐ điểm đứng được đóng băng
local frozenStandRadius = nil
local lastScan = 0
local lastSend = 0
local lastPos = nil
local stuckTimer = 0
local forceRiseTimer = 0

-- ============ XOÁ UI CŨ ============
for _, g in ipairs(LP:WaitForChild("PlayerGui"):GetChildren()) do
    if g.Name == "AutoWhaleUI" or g.Name:match("^AutoWhaleUI") then
        g:Destroy()
    end
end

-- ============ RAYCAST ============
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function refreshRayFilter()
    local ignore = { char }
    if currentTarget then
        table.insert(ignore, currentTarget)
        for _, d in ipairs(currentTarget:GetDescendants()) do
            if d:IsA("BasePart") then table.insert(ignore, d) end
        end
    end
    rayParams.FilterDescendantsInstances = ignore
end

local function rayBlocked(origin, dir, length)
    return workspace:Raycast(origin, dir * length, rayParams) ~= nil
end

-- ============ HELPER ============
local function getWhaleInfo(model)
    if not model or not model.Parent then return nil end

    local center
    if model.PrimaryPart then
        center = model.PrimaryPart.Position
    else
        local biggest, bs = nil, 0
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then
                local sz = d.Size.Magnitude
                if sz > bs then biggest, bs = d, sz end
            end
        end
        if biggest then center = biggest.Position end
        if not center then
            local ok, cf = pcall(function() return model:GetBoundingBox() end)
            if ok and cf then center = cf.Position end
        end
    end
    if not center then return nil end

    local radius = 30
    local biggest = 0
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            local r = math.max(d.Size.X, d.Size.Z) * 0.5
            if r > biggest and r <= MAX_RADIUS then biggest = r end
        end
    end
    if biggest > 0 then radius = biggest end

    return { center = center, radius = radius }
end

local function sendDash(cf)
    local now = tick()
    if now - lastSend >= SEND_INTERVAL then
        Remote:FireServer("Dash", cf)
        lastSend = now
    end
end

local function findNearestWhale()
    local myPos = hrp.Position
    local best, bestDist = nil, math.huge
    for _, model in ipairs(WhaleFolder:GetChildren()) do
        if model:IsA("Model") then
            local info = getWhaleInfo(model)
            if info then
                local d = (info.center - myPos).Magnitude
                if d < bestDist then best, bestDist = model, d end
            end
        end
    end
    return best
end

-- ⭐ Đóng băng điểm đứng dựa vào hướng player hiện tại tới whale
local function freezeStandPos()
    if not currentTarget then return end
    local info = getWhaleInfo(currentTarget)
    if not info then return end

    local myPos = hrp.Position
    local center = info.center
    local horiz = Vector3.new(myPos.X - center.X, 0, myPos.Z - center.Z)

    -- Nếu player đang ở ngay trên tâm whale → chọn hướng mặc định (Bắc)
    if horiz.Magnitude < 10 then
        horiz = Vector3.new(1, 0, 0)
    end
    local horizUnit = horiz.Unit

    local standRadius = info.radius + STAND_DISTANCE
    local standXZ = Vector3.new(center.X, 0, center.Z) + horizUnit * standRadius
    local standY  = center.Y + HOVER_Y

    frozenStandPos = Vector3.new(standXZ.X, standY, standXZ.Z)
    frozenStandRadius = standRadius
    print(string.format("[AutoWhale] Đóng băng điểm đứng: (%.0f, %.0f, %.0f) | radius: %.0f",
        frozenStandPos.X, frozenStandPos.Y, frozenStandPos.Z, standRadius))
end

local function scanFolder(force)
    local now = tick()
    if not force and now - lastScan < SCAN_INTERVAL then return end
    lastScan = now

    local newTarget = findNearestWhale()
    if newTarget and newTarget ~= currentTarget then
        currentTarget = newTarget
        frozenStandPos = nil
        frozenStandRadius = nil
        refreshRayFilter()
        freezeStandPos()  -- ⭐ tính 1 lần
    elseif not newTarget then
        currentTarget = nil
        frozenStandPos = nil
        frozenStandRadius = nil
    end
end

WhaleFolder.ChildAdded:Connect(function(child)
    if child:IsA("Model") and ENABLED then
        currentTarget = child
        frozenStandPos = nil
        frozenStandRadius = nil
        refreshRayFilter()
        freezeStandPos()
    end
end)

-- ============ ON/OFF ============
local function setEnabled(state)
    ENABLED = state
    stuckTimer = 0
    forceRiseTimer = 0
    lastPos = nil
    local c = LP.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        local r = c:FindFirstChild("HumanoidRootPart")
        if h then
            h.PlatformStand = state
            h.WalkSpeed     = state and 0 or 16
            h.JumpPower     = state and 0 or 50
            h.UseJumpPower  = true
        end
        if r then
            r.AssemblyLinearVelocity  = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

-- ============ UI ============
local function createUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "AutoWhaleUI"
    gui.ResetOnSpawn = false
    gui.Parent = LP:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 230, 0, 85)
    frame.Position = UDim2.new(0, 20, 0, 100)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(60, 60, 70)
    stroke.Thickness = 1.5

    local title = Instance.new("TextLabel", frame)
    title.Size = UDim2.new(1, 0, 0, 25)
    title.Position = UDim2.new(0, 0, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = "🐋 AUTO WHALE v10"
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.TextColor3 = Color3.fromRGB(240, 240, 240)

    local status = Instance.new("TextLabel", frame)
    status.Size = UDim2.new(1, -20, 0, 14)
    status.Position = UDim2.new(0, 10, 0, 28)
    status.BackgroundTransparency = 1
    status.Text = "Trạng thái: idle"
    status.Font = Enum.Font.Gotham
    status.TextSize = 11
    status.TextColor3 = Color3.fromRGB(160, 160, 170)
    status.TextXAlignment = Enum.TextXAlignment.Left

    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(1, -20, 0, 26)
    btn.Position = UDim2.new(0, 10, 0, 48)
    btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    btn.BorderSizePixel = 0
    btn.Text = "OFF"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        setEnabled(not ENABLED)
        if ENABLED then
            btn.Text = "ON"
            btn.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
            scanFolder(true)
        else
            btn.Text = "OFF"
            btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        end
    end)

    return gui, status
end

local ui, statusLabel = createUI()

-- ============ MAIN LOOP ============
RunService.Heartbeat:Connect(function(dt)
    if not char.Parent or not hrp.Parent then
        char = LP.Character or LP.CharacterAdded:Wait()
        hrp  = char:WaitForChild("HumanoidRootPart")
        hum  = char:WaitForChild("Humanoid")
        if ENABLED then hum.PlatformStand = true; hum.WalkSpeed = 0 end
        lastPos = nil
        return
    end

    if not ENABLED then
        statusLabel.Text = "Trạng thái: OFF"
        return
    end

    scanFolder(false)
    if not currentTarget or not currentTarget.Parent then
        currentTarget = nil
        frozenStandPos = nil
        statusLabel.Text = "Trạng thái: chờ whale..."
        return
    end

    -- Nếu vì lý do gì đó chưa có điểm đứng → tính lại
    if not frozenStandPos then
        freezeStandPos()
        if not frozenStandPos then
            statusLabel.Text = "Không lấy được info whale"
            return
        end
    end

    local myPos = hrp.Position
    local standPos = frozenStandPos

    -- ============ STUCK DETECTION ============
    if lastPos then
        local moved = (myPos - lastPos).Magnitude
        if moved < 0.5 then
            stuckTimer = stuckTimer + dt
        else
            stuckTimer = math.max(0, stuckTimer - dt * 2)
        end
    end
    lastPos = myPos

    if stuckTimer >= STUCK_TIME and forceRiseTimer <= 0 then
        forceRiseTimer = 1.5
        stuckTimer = 0
    end
    if forceRiseTimer > 0 then
        forceRiseTimer = forceRiseTimer - dt
    end

    -- ============ KHOẢNG CÁCH ============
    local distToStand = (standPos - myPos).Magnitude

    -- ============ STOP ============
    if distToStand <= STOP_TOL then
        statusLabel.Text = string.format("✅ ĐÃ ĐỨNG | còn:%.0f", distToStand)
        return
    end

    -- ============ QUYẾT ĐỊNH HƯỚNG ============
    local moveTarget = standPos
    local phaseText  = "fly"

    -- Tính edgeDist (tới whale) để quyết định có được phép bay lên
    local info = getWhaleInfo(currentTarget)
    local edgeDist = 9999
    if info then
        edgeDist = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(info.center.X, 0, info.center.Z)).Magnitude - info.radius
    end

    if forceRiseTimer > 0 then
        phaseText = "rise-stuck"
        moveTarget = Vector3.new(myPos.X, myPos.Y + 30, myPos.Z)
    elseif edgeDist > NO_RISE_DIST then
        local dirToStand = standPos - myPos
        local flat = Vector3.new(dirToStand.X, 0, dirToStand.Z)
        local len  = math.min(flat.Magnitude, RAY_LENGTH)
        if len > 0.1 and rayBlocked(myPos, flat.Unit, len) then
            local info2 = getWhaleInfo(currentTarget)
            local cy = info2 and info2.center.Y or 0
            local safeY = math.max(cy + SAFE_HEIGHT, HIGH_Y_MIN)
            if myPos.Y < safeY - 10 then
                phaseText = "rise"
                moveTarget = Vector3.new(myPos.X, safeY, myPos.Z)
            else
                phaseText = "fly-high"
                moveTarget = Vector3.new(standPos.X, safeY, standPos.Z)
            end
        end
    end

    -- ============ DI CHUYỂN ============
    local diff     = moveTarget - myPos
    local distance = diff.Magnitude
    if distance < 0.5 then return end

    local dir  = diff.Unit
    local step = math.min(SPEED * dt, distance)
    local newPos = myPos + dir * step
    local newCF  = CFrame.new(newPos) * (hrp.CFrame - hrp.CFrame.Position)

    hrp.CFrame = newCF
    hrp.AssemblyLinearVelocity  = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    sendDash(newCF)

    statusLabel.Text = string.format(
        "%s | còn:%.0f | stk:%.1f",
        phaseText, distToStand, stuckTimer)
end)

print("[AutoWhale v10] Loaded — điểm đứng cố định")
