-- ============================================
-- AUTO WHALE v6.7 — DEFINITIVE FIX
-- ============================================

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting          = game:GetService("Lighting")
local Workspace         = game:GetService("Workspace")

local LP   = Players.LocalPlayer
local char, hrp, hum

-- ============ CONFIG ============
local SPEED            = 250
local SCAN_INTERVAL    = 0.3       -- ⭐ scan nhanh hơn để bắt whale mới

local STAND_DISTANCE   = 60
local EDGE_PADDING     = 10
local HOVER_Y_OFFSET   = 5

local SAFE_HEIGHT      = 60
local HIGH_Y_MIN       = 120
local H_ARRIVE_XZ      = 120
local DESCEND_SPEED    = 200
local SEND_INTERVAL    = 0.08

local MIN_FLIGHT_TIME  = 1.5
local MIN_FLIGHT_DIST  = 30
local MAX_WHALE_RADIUS = 300

local ARRIVE_TOLERANCE = 5
local ARRIVE_Y_TOL     = 8

local REARM_COOLDOWN   = 3         -- ⭐ giảm từ 5 → 3 cho nhanh re-arm
local AUTO_RETRY_DELAY = 1
local STUCK_TIME_LIMIT = 3.0

-- LOW SPEC
local TARGET_FPS       = 15
local FRAME_TIME       = 1 / TARGET_FPS
local VIEW_DISTANCE    = 350
local CLEANUP_INTERVAL = 60

-- ============ STATE ============
local ENABLED      = false
local AUTO_MODE    = true
local currentTarget = nil
local lastScan     = 0
local lastSend     = 0
local toggleBtn, autoBtn, forceBtn, statusLabel

local flightStartTime = 0
local flightStartPos  = nil

local lastReleasedWhale = nil
local lastReleaseTime   = 0
local lastAutoRetry     = 0
local processedWhales   = {}

local lastPos = Vector3.zero
local stuckTimer = 0
local frameAccum = 0

-- ============ DYNAMIC REFS ============
local Remote      = nil
local WhaleFolder = nil

local function getRemote()
    if Remote and Remote.Parent then return Remote end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    Remote = remotes and remotes:FindFirstChild("Input") or nil
    return Remote
end

-- ⭐ Luôn lấy folder mới nhất (không cache kiểu "nếu còn parent thì dùng")
local function getWhaleFolder()
    local f = Workspace:FindFirstChild("Whale")
    if f then WhaleFolder = f end
    return WhaleFolder
end

-- ============ XOÁ UI CŨ ============
for _, g in ipairs(LP:WaitForChild("PlayerGui"):GetChildren()) do
    if g.Name == "AutoWhaleUI" or g.Name:match("^AutoWhaleUI") then
        g:Destroy()
    end
end

-- ============ LOW-SPEC ============
local function applyLowSpec()
    pcall(function()
        local s = settings()
        s.Rendering.QualityLevel = Enum.QualityLevel.Level01
        s.Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
    end)
    pcall(function()
        Lighting.GlobalShadows            = false
        Lighting.FogEnd                   = VIEW_DISTANCE
        Lighting.FogStart                 = VIEW_DISTANCE * 0.6
        Lighting.Brightness               = 1
        Lighting.EnvironmentDiffuseScale  = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.Outlines                 = false
        Lighting.ShadowSoftness           = 0
    end)
    pcall(function()
        local Terrain = Workspace:FindFirstChildOfClass("Terrain")
        if Terrain then
            Terrain.Decoration        = false
            Terrain.WaterWaveSize     = 0
            Terrain.WaterWaveSpeed    = 0
            Terrain.WaterReflectance  = 0
            Terrain.WaterTransparency = 1
        end
    end)
end

local function cullDistantObjects()
    if not hrp then return end
    local myPos = hrp.Position
    local dist2 = VIEW_DISTANCE * VIEW_DISTANCE
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("BasePart") and d ~= hrp then
            local ok, dist = pcall(function() return (d.Position - myPos).Magnitude end)
            if ok then
                pcall(function()
                    d.LocalTransparencyModifier = (dist * dist > dist2) and 1 or 0
                end)
            end
        elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
            or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
            pcall(function() d.Enabled = false end)
        elseif d:IsA("Decal") then
            pcall(function() d.LocalTransparencyModifier = 1 end)
        end
    end
end

local function cullPlayers()
    if not hrp then return end
    local myPos = hrp.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local hide = (root.Position - myPos).Magnitude > VIEW_DISTANCE
                for _, d in ipairs(plr.Character:GetDescendants()) do
                    if d:IsA("BasePart") then
                        pcall(function()
                            d.LocalTransparencyModifier = hide and 1 or 0
                        end)
                    end
                end
            end
        end
    end
end

-- ============ HELPER ============
local function getWhaleInfo(model)
    if not model or not model.Parent then return nil, 0 end

    local center
    local ok, cf = pcall(function() return model:GetBoundingBox() end)
    if ok and cf then
        center = cf.Position
    else
        local part = model:FindFirstChildWhichIsA("BasePart", true)
        if part then center = part.Position end
    end
    if not center then return nil, 0 end

    local maxR = 0
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency < 0.9 then
            local r = math.max(d.Size.X, d.Size.Z) * 0.5
            if r > maxR then maxR = r end
        end
    end
    if maxR > MAX_WHALE_RADIUS then maxR = MAX_WHALE_RADIUS end
    return center, maxR
end

local function sendDash(cf)
    local now = tick()
    if now - lastSend >= SEND_INTERVAL then
        local r = getRemote()
        if r then
            r:FireServer("Dash", cf)
            lastSend = now
        end
    end
end

local function isProcessed(whale)
    return processedWhales[whale] == true
end

-- ⭐ Tìm whale — luôn lấy folder mới nhất, không cache
local function findNearestWhale()
    if not hrp then return nil end
    local folder = getWhaleFolder()
    if not folder then return nil end
    local myPos = hrp.Position
    local best, bestDist = nil, math.huge
    for _, model in ipairs(folder:GetChildren()) do
        if model:IsA("Model") and not isProcessed(model) then
            local center = getWhaleInfo(model)
            if center then
                local d = (center - myPos).Magnitude
                if d < bestDist then best, bestDist = model, d end
            end
        end
    end
    return best
end

-- ⭐ Scan — KHÔNG phụ thuộc ChildAdded, tự tìm mỗi lần gọi
local function scanFolder(force)
    local now = tick()
    if not force and now - lastScan < SCAN_INTERVAL then return end
    lastScan = now

    -- Nếu target cũ còn sống → giữ
    if currentTarget and currentTarget.Parent and not isProcessed(currentTarget) then
        return
    end

    -- Target chết → tìm cái mới
    currentTarget = findNearestWhale()
end

-- ============ SET ENABLED ============
function setEnabled(state)
    ENABLED = state
    if char then
        local h = char:FindFirstChildOfClass("Humanoid")
        local r = char:FindFirstChild("HumanoidRootPart")
        if h then
            h.PlatformStand = state
            h.WalkSpeed     = state and 0 or 16
            h.JumpPower     = state and 0 or 50
            h.UseJumpPower  = true
        end
        if r then
            r.AssemblyLinearVelocity  = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end
    end
    if state and hrp then
        flightStartTime = tick()
        flightStartPos  = hrp.Position
        lastPos = hrp.Position
        stuckTimer = 0
    end
end

local function syncUI()
    if toggleBtn then
        toggleBtn.Text = ENABLED and "ON" or "OFF"
        toggleBtn.BackgroundColor3 = ENABLED
            and Color3.fromRGB(50, 180, 90)
            or  Color3.fromRGB(200, 50, 50)
    end
    if autoBtn then
        autoBtn.Text = AUTO_MODE and "AUTO ✓" or "AUTO ✗"
        autoBtn.BackgroundColor3 = AUTO_MODE
            and Color3.fromRGB(50, 130, 200)
            or  Color3.fromRGB(80, 80, 90)
    end
end

-- ============ CHARACTER ============
local function onCharacterAdded(newChar)
    char = newChar
    hrp  = char:WaitForChild("HumanoidRootPart")
    hum  = char:WaitForChild("Humanoid")

    currentTarget = nil
    flightStartTime = tick()
    flightStartPos = hrp.Position
    lastPos = hrp.Position
    stuckTimer = 0

    if ENABLED then
        hum.PlatformStand = true
        hum.WalkSpeed     = 0
        hum.JumpPower     = 0
        hum.UseJumpPower  = true
    end
    task.wait(0.5)
    scanFolder(true)
end

if LP.Character then
    task.spawn(onCharacterAdded, LP.Character)
end
LP.CharacterAdded:Connect(onCharacterAdded)

-- ============ RELEASE ============
local function releaseCharacter()
    if not char then return end
    local h = char:FindFirstChildOfClass("Humanoid")
    local r = char:FindFirstChild("HumanoidRootPart")
    if h then
        h.PlatformStand = false
        h.WalkSpeed     = 16
        h.JumpPower     = 50
        h.UseJumpPower  = true
    end
    if r then
        r.AssemblyLinearVelocity  = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
end

local function markReleased(whale)
    if whale then
        processedWhales[whale] = true
        lastReleasedWhale = whale
    end
    lastReleaseTime = tick()
end

-- ============ CLEANUP 60s ============
task.spawn(function()
    while true do
        task.wait(CLEANUP_INTERVAL)
        for w in pairs(processedWhales) do
            if typeof(w) ~= "Instance" or not w.Parent then
                processedWhales[w] = nil
            end
        end
        pcall(function()
            collectgarbage("collect")
            collectgarbage("collect")
        end)
        applyLowSpec()
        pcall(cullDistantObjects)
        pcall(cullPlayers)
    end
end)

