-- ============================================
-- AUTO WHALE v6.2 — STOP 60 STUDS + AUTO RELEASE
-- ============================================

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LP   = Players.LocalPlayer
local char = LP.Character or LP.CharacterAdded:Wait()
local hrp  = char:WaitForChild("HumanoidRootPart")
local hum  = char:WaitForChild("Humanoid")

local Remote      = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Input")
local WhaleFolder = workspace:WaitForChild("Whale")

-- ============ CONFIG ============
local SPEED            = 200
local SCAN_INTERVAL    = 0.5

local STAND_DISTANCE   = 60    -- khoảng cách tối thiểu từ TÂM whale
local EDGE_PADDING     = 10    -- ⭐ cách MÉP whale ít nhất bao nhiêu studs
local HOVER_Y_OFFSET   = 5

local SAFE_HEIGHT      = 60
local HIGH_Y_MIN       = 120
local H_ARRIVE_XZ      = 120
local DESCEND_SPEED    = 350
local SEND_INTERVAL    = 0.05

local ARRIVE_TOLERANCE = 3     -- dung sai XZ khi coi là "đã tới"
local ARRIVE_Y_TOL     = 8     -- dung sai Y khi coi là "đã tới"

-- ============ STATE ============
local ENABLED = false
local currentTarget = nil
local lastScan = 0
local lastSend = 0
local toggleBtn = nil
local statusLabel = nil

-- ============ XOÁ UI CŨ ============
for _, g in ipairs(LP:WaitForChild("PlayerGui"):GetChildren()) do
    if g.Name == "AutoWhaleUI" or g.Name:match("^AutoWhaleUI") then
        g:Destroy()
    end
end

-- ============ HELPER ============
local function getWhaleCenterAndSize(model)
    if not model or not model.Parent then return nil, nil end
    local ok, cf, size = pcall(function()
        local c, s = model:GetBoundingBox()
        return c, s
    end)
    if ok and cf then return cf.Position, size end
    local part = model:FindFirstChildWhichIsA("BasePart", true)
    if part then return part.Position, part.Size end
    return nil, nil
end

local function sendDash(cf)
    local now = tick()
    if now - lastSend >= SEND_INTERVAL then
        Remote:FireServer("Dash", cf)
        lastSend = now
    end
end

local function findNearestWhale()
    local myPos = hrp.Position
    local best, bestDist = nil, math.huge
    for _, model in ipairs(WhaleFolder:GetChildren()) do
        if model:IsA("Model") then
            local center = getWhaleCenterAndSize(model)
            if center then
                local d = (center - myPos).Magnitude
                if d < bestDist then best, bestDist = model, d end
            end
        end
    end
    return best
end

local function scanFolder(force)
    local now = tick()
    if not force and now - lastScan < SCAN_INTERVAL then return end
    lastScan = now
    local newTarget = findNearestWhale()
    if newTarget and newTarget ~= currentTarget then
        currentTarget = newTarget
    elseif not newTarget then
        currentTarget = nil
    end
end

WhaleFolder.ChildAdded:Connect(function(child)
    if child:IsA("Model") and ENABLED then
        currentTarget = child
    end
end)

-- ============ RELEASE — TRẢ PHYSICS VỀ BÌNH THƯỜNG ============
local function releaseCharacter()
    local c = LP.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if h then
        h.PlatformStand = false
        h.WalkSpeed     = 16
        h.JumpPower     = 50
        h.UseJumpPower  = true
    end
    if r then
        r.AssemblyLinearVelocity  = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
end

-- ============ ON/OFF ============
local function setEnabled(state)
    ENABLED = state
    local c = LP.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        local r = c:FindFirstChild("HumanoidRootPart")
        if h then
            h.PlatformStand = state
            h.WalkSpeed     = state and 0 or 16
            h.JumpPower     = state and 0 or 50
            h.UseJumpPower  = true
        end
        if r then
            r.AssemblyLinearVelocity  = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function syncUI()
    if not toggleBtn then return end
    if ENABLED then
        toggleBtn.Text = "ON"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
    else
        toggleBtn.Text = "OFF"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end

-- ============ UI ============
local function createUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "AutoWhaleUI"
    gui.ResetOnSpawn = false
    gui.Parent = LP:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 85)
    frame.Position = UDim2.new(0, 20, 0, 100)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(60, 60, 70)
    stroke.Thickness = 1.5

    local title = Instance.new("TextLabel", frame)
    title.Size = UDim2.new(1, 0, 0, 25)
    title.Position = UDim2.new(0, 0, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = "🐋 AUTO WHALE v6.2"
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.TextColor3 = Color3.fromRGB(240, 240, 240)

    local status = Instance.new("TextLabel", frame)
    status.Size = UDim2.new(1, -20, 0, 14)
    status.Position = UDim2.new(0, 10, 0, 28)
    status.BackgroundTransparency = 1
    status.Text = "Trạng thái: idle"
    status.Font = Enum.Font.Gotham
    status.TextSize = 11
    status.TextColor3 = Color3.fromRGB(160, 160, 170)
    status.TextXAlignment = Enum.TextXAlignment.Left
    statusLabel = status

    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(1, -20, 0, 26)
    btn.Position = UDim2.new(0, 10, 0, 48)
    btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    btn.BorderSizePixel = 0
    btn.Text = "OFF"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    toggleBtn = btn

    btn.MouseButton1Click:Connect(function()
        setEnabled(not ENABLED)
        syncUI()
        if ENABLED then
            scanFolder(true)
        end
    end)

    return gui
end

createUI()

-- ============ MAIN LOOP ============
RunService.Heartbeat:Connect(function(dt)
    -- Cập nhật character nếu respawn
    if not char.Parent or not hrp.Parent then
        char = LP.Character or LP.CharacterAdded:Wait()
        hrp  = char:WaitForChild("HumanoidRootPart")
        hum  = char:WaitForChild("Humanoid")
        if ENABLED then
            hum.PlatformStand = true
            hum.WalkSpeed = 0
        end
        return
    end

    if not ENABLED then
        statusLabel.Text = "Trạng thái: OFF"
        return
    end

    scanFolder(false)
    if not currentTarget or not currentTarget.Parent then
        currentTarget = nil
        statusLabel.Text = "Trạng thái: chờ whale..."
        return
    end

    -- Lấy tâm + kích thước whale
    local center, whaleSize = getWhaleCenterAndSize(currentTarget)
    if not center then return end

    local myPos = hrp.Position

    -- ⭐ Bán kính ngang của whale để tránh kẹt vào model
    local whaleRadius = 0
    if whaleSize then
        whaleRadius = math.max(whaleSize.X, whaleSize.Z) * 0.5
    end

    -- Khoảng đứng: cách MÉP whale ít nhất EDGE_PADDING studs
    local standDist = math.max(STAND_DISTANCE, whaleRadius + EDGE_PADDING)

    -- Vector ngang từ whale tới player
    local horiz = Vector3.new(myPos.X - center.X, 0, myPos.Z - center.Z)
    if horiz.Magnitude < 0.1 then
        horiz = Vector3.new(1, 0, 0)
    end
    local horizUnit = horiz.Unit

    -- Điểm đứng
    local standXZ  = Vector3.new(center.X, 0, center.Z) + horizUnit * standDist
    local standY   = center.Y + HOVER_Y_OFFSET
    local standPos = Vector3.new(standXZ.X, standY, standXZ.Z)

    local flatDist = horiz.Magnitude
    local dy       = myPos.Y - standY

    -- ============ ĐÃ TỚI → THẢ XUỐNG ============
    if flatDist <= standDist + ARRIVE_TOLERANCE and math.abs(dy) <= ARRIVE_Y_TOL then
        statusLabel.Text = string.format("✅ ĐÃ TỚI (XZ:%.0f | Y:%.0f) — THẢ XUỐNG", flatDist, dy)
        setEnabled(false)      -- tắt điều khiển
        releaseCharacter()     -- trả physics → nhân vật rơi tự do
        syncUI()               -- cập nhật nút thành OFF
        return
    end

    -- ============ QUYẾT ĐỊNH ============
    local arriveXZ = math.max(H_ARRIVE_XZ, standDist + 40)
    local moveTarget, speed

    if flatDist > arriveXZ then
        local safeY = math.max(center.Y + SAFE_HEIGHT, HIGH_Y_MIN)
        if myPos.Y < safeY - 10 then
            statusLabel.Text = string.format("rise | XZ:%.0f", flatDist)
            speed = SPEED
            moveTarget = Vector3.new(myPos.X, safeY, myPos.Z)
        else
            statusLabel.Text = string.format("fly  | XZ:%.0f", flatDist)
            speed = SPEED
            moveTarget = Vector3.new(standXZ.X, safeY, standXZ.Z)
        end
    else
        statusLabel.Text = string.format("descend | XZ:%.0f | Y:%.0f", flatDist, dy)
        speed = DESCEND_SPEED
        moveTarget = standPos
    end

    -- ============ DI CHUYỂN ============
    local diff     = moveTarget - myPos
    local distance = diff.Magnitude
    if distance < 0.5 then return end

    local dir    = diff.Unit
    local step   = math.min(speed * dt, distance)
    local newPos = myPos + dir * step
    local newCF  = CFrame.new(newPos) * (hrp.CFrame - hrp.CFrame.Position)

    hrp.CFrame = newCF
    hrp.AssemblyLinearVelocity  = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    sendDash(newCF)
end)

print("[AutoWhale v6.2] Loaded — click ON để bật (auto release khi tới)")
